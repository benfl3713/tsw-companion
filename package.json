{
  "name": "tsw-companion",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm start -w @tsw/bridge --",
    "probe": "npm run probe -w @tsw/bridge --",
    "watch": "npm run watch -w @tsw/bridge --",
    "test": "npm test -w @tsw/bridge",
    "dev:web": "npm run dev -w @tsw/web",
    "build": "npm run build -w @tsw/web",
    "typecheck": "tsc -b && npm run typecheck -w @tsw/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
